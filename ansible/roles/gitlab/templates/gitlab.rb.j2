# ansible/roles/gitlab/templates/gitlab.rb.j2
external_url 'http://{{ box_ip }}'

gitlab_rails['omniauth_allow_single_sign_on']      = ['openid_connect']
gitlab_rails['omniauth_sync_email_from_provider']   = 'openid_connect'
gitlab_rails['omniauth_auto_sign_in_with_provider'] = 'openid_connect'
gitlab_rails['omniauth_block_auto_created_users']   = false

gitlab_rails['omniauth_providers'] = [
  {
    name:  "openid_connect",
    label: "Company SSO",
    args: {
      name:               "openid_connect",
      scope:              ["openid", "profile", "email"],
      response_type:      "code",
      issuer:             "http://{{ box_ip }}:8080/realms/{{ keycloak_realm }}",
      discovery:          false,
      client_auth_method: "query",
      uid_field:          "preferred_username",
      client_options: {
        identifier:             "{{ gitlab_oidc_client_id }}",
        secret:                 "{{ gitlab_oidc_client_secret }}",
        redirect_uri:           "http://{{ box_ip }}/users/auth/openid_connect/callback",

        # Browser-facing — public IP (player's browser redirects here)
        authorization_endpoint: "http://{{ box_ip }}:8080/realms/{{ keycloak_realm }}/protocol/openid-connect/auth",

        # Backend-facing — internal IP (GitLab container → Keycloak, no hairpin)
        token_endpoint:         "http://10.0.1.4:8080/realms/{{ keycloak_realm }}/protocol/openid-connect/token",
        userinfo_endpoint:      "http://10.0.1.4:8080/realms/{{ keycloak_realm }}/protocol/openid-connect/userinfo",
        jwks_uri:               "http://10.0.1.4:8080/realms/{{ keycloak_realm }}/protocol/openid-connect/certs"
      }
    }
  }
]